NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/autoparts
IP_ADDRESS=0.0.0.0
PORT=5000
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRE_IN=30d
CORS_ORIGINS=http://localhost:3000
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=JBAY
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
CLOUDFRONT_DOMAIN=
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
